<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Add filter for city of customer-->
    <record id="binaural_location_account_move_view_search" model="ir.ui.view">
        <field name="name">binaural.account.move.view.search</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <filter name="client_city_id" string="Customer city" context="{'group_by':'client_city_id'}" />
                <filter name="state_customer_id" string="Customer state"  context="{'group_by': 'state_customer_id'}" />
            </field>
        </field>
    </record>
    <!-- Add field city_id to the record father-->
    <record id="binaural_location_account_move_tree" model="ir.ui.view">
        <field name="name">account.move.tree.binaural.invoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date_due']" position="after">
                <field name="client_city_id" string="Customer city" optional="hide" />
                <field name="state_customer_id" string="Customer state" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>