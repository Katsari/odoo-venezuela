<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<record id="view_search_group_by_seller_sale_report" model="ir.ui.view">
		<field name="name">view.search.group.by.seller.sale.report</field>
		<field name="model">sale.report</field>
		<field name="inherit_id" ref="sale.view_order_product_search" />
		<field name="arch" type="xml">
			<field name="partner_id" position="after">
				<filter name="client_city_id" string="Customer city" context="{'group_by':'client_city_id'}" />
				<filter name="state_customer_id" string="Customer state" context="{'group_by':'state_customer_id'}" />
			</field>
		</field>
	</record>
</odoo>
